# Copy to deployment/.env and fill in every REPLACE_* value.
#
#   cp deployment/.env.example deployment/.env
#
# The gateway refuses to boot in production while a placeholder is still
# present (see gateway/app/config.py::validate_settings), so a half-configured
# deployment fails loudly at startup instead of silently running with
# `change-me` as its signing key.

# ── runtime ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
ENGINE_MODE=builtin
IMAGE_TAG=latest

# ── database ───────────────────────────────────────────────────────────────
# The password here must equal POSTGRES_PASSWORD below.
DATABASE_URL=postgresql+psycopg://support:REPLACE_DB_PASSWORD@postgres:5432/support
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
# Creates any missing tables from the models at startup. This is convenient for
# a throwaway database and WRONG for one that holds data: ``create_all`` only
# ever creates, so adding a column to a model changes nothing on a database that
# already has the table — the column silently never appears.
#
# Leave this at 0 in any environment that keeps its data, and apply schema
# changes with ``bash scripts/migrate.sh`` (which runs ``alembic upgrade head``
# and adopts a create_all-built database by stamping the baseline). Set it to 1
# only for a scratch database you are happy to lose.
AUTO_CREATE_SCHEMA=0
# Seeds the demo tenant + the platform-global knowledge base. Set to 0 once you
# have your own data and do not want demo accounts recreated on restart.
AUTO_SEED=1

# ── database connection pool ───────────────────────────────────────────────
# These are not cosmetic. ``/api/chat/stream`` keeps its request-scoped session
# alive for the entire SSE response, so one streaming client occupies one pooled
# connection for as long as it streams. The number of *concurrent* streams a
# single worker can serve is therefore bounded by DB_POOL_SIZE +
# DB_MAX_OVERFLOW — and the request that arrives after that blocks for
# DB_POOL_TIMEOUT_SECONDS and then fails with a 500.
#
# Default 5 + 10 = 15 concurrent streams. Raise these together with
# PostgreSQL's ``max_connections`` (default 100, shared with business-service,
# Grafana and any psql session), never one without the other.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Recycle connections before an idle firewall / NAT drops them silently.
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
# Server-side guardrail: kill any transaction left idle this long. An unclosed
# transaction holds a snapshot, which stops autovacuum from reclaiming anything
# newer than it — the table grows while the application looks healthy. Observed
# in production on this deployment; see docs/OPERATIONS.md §10.
DB_IDLE_TX_TIMEOUT_MS=300000

# ── cache / rate limit ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── auth ───────────────────────────────────────────────────────────────────
# REQUIRED: jwt in production. dev/none exist only for local demos.
AUTH_MODE=jwt
# REQUIRED: >= 32 random chars. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_32PLUS_RANDOM_HEX
JWT_ISSUER=support-platform
ACCESS_TOKEN_TTL_MINUTES=720

# ── tenancy & quota ────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
TENANT_DAILY_MESSAGE_QUOTA=5000
# The public origin, e.g. https://your-domain. Used for CORS.
CORS_ORIGINS=https://REPLACE_DOMAIN

# ── business service ───────────────────────────────────────────────────────
BUSINESS_SERVICE_URL=http://business-service:9000
# REQUIRED: the agent-facing credential. It can create a refund proposal but
# can never approve one.
TOOL_API_KEY=REPLACE_WITH_STRONG_TOOL_KEY
# REQUIRED: the human-reviewer credential. It is used by two callers:
#   1. the reviewer surface, to decide an approval;
#   2. the *gateway*, to relay that decision back into the business service's
#      own review state machine before executing.
# Without it the gateway still records the approval, but the order system is
# never told, so a refund is approved and silently never executed.
REVIEWER_API_KEY=REPLACE_WITH_STRONG_REVIEWER_KEY
REVIEWER_ID=human-reviewer-01

# ── image build ────────────────────────────────────────────────────────────
# The default PyPI index can be slow or unreachable from mainland-China hosts.
# Point this at a mirror, or at https://pypi.org/simple/ elsewhere.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com

# ── intent routing ─────────────────────────────────────────────────────────
# Below INTENT_LLM_THRESHOLD the deterministic scorer hands over to the LLM.
INTENT_LLM_THRESHOLD=0.55
# Below this, even the model is not trusted and the turn goes to a human.
INTENT_HANDOFF_THRESHOLD=0.35

# ── knowledge base ─────────────────────────────────────────────────────────
KNOWLEDGE_TOP_K=4

# ── LLM (OpenAI-compatible / DeepSeek) ─────────────────────────────────────
# LLM_ENABLED=0 keeps the service fully functional with deterministic answers
# only — useful when the provider is down or during a cost review.
#
# The model is consulted at exactly two read-only nodes: low-confidence intent
# fallback, and phrasing an answer that already has grounding. It never picks a
# tool, never approves anything, never changes state, and every failure falls
# back to the deterministic path.
LLM_ENABLED=1
# No trailing /v1: the client appends /chat/completions, and the current
# DeepSeek docs list https://api.deepseek.com as the base.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=REPLACE_WITH_LLM_KEY
# deepseek-flash is the current documented name (DeepSeek-V4.1-Flash).
# deepseek-chat still resolves to the same model but is an undocumented alias.
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
# DeepSeek V4 defaults to *thinking* mode, which spends the completion budget on
# reasoning_content before emitting any answer. Both nodes here are short and
# structured, so thinking costs latency and tokens for nothing — and at the
# intent classifier's max_tokens=80 it can consume the whole budget and return
# an empty content, silently breaking the fallback. Set to `auto` to send no
# thinking key at all (needed for non-DeepSeek endpoints that reject it).
LLM_THINKING=disabled
# Prices per 1K tokens, used only for the cost metric. Set them to your
# provider's real numbers or the cost panel will read 0.
# These are DeepSeek's peak-hour list prices; off-peak is half. Cache hits are
# ~50x cheaper on input and are priced separately.
LLM_PRICE_IN_PER_1K=0.0003
LLM_PRICE_IN_CACHED_PER_1K=0.000006
LLM_PRICE_OUT_PER_1K=0.0012

# ── embeddings (semantic half of hybrid retrieval) ─────────────────────────
# Leave disabled to run keyword-only retrieval. Enable once you have an
# OpenAI-compatible /embeddings endpoint; retrieval then fuses BM25 + vectors.
EMBEDDING_ENABLED=0
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── grafana (loopback only, reached over an SSH tunnel) ────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_STRONG_GRAFANA_PASSWORD

# ── alertmanager (loopback only, reached over an SSH tunnel) ───────────────
# Prometheus evaluates the rules in observability/alerts.yml regardless, but
# Alertmanager is what actually delivers them. Leave this empty and the stack
# still starts — alerts stay visible in the Alertmanager UI and on the Grafana
# 「正在告警」panel — but nothing is pushed anywhere, and Alertmanager logs a
# "no such host alert-webhook-not-configured.invalid" delivery error each time
# an alert fires. That error is intentional: it names the misconfiguration.
#
# Point it at a WeCom / DingTalk / Feishu bot URL, or any endpoint that accepts
# a JSON POST, to receive notifications for real.
ALERT_WEBHOOK_URL=
