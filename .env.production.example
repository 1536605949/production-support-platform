# Production template: copy to deployment/.env on the prod host and replace every
# REPLACE_* value. The Gateway refuses known placeholders when ENVIRONMENT=production
# (see gateway/app/config.py validate_settings) and readyz reports not_ready for them.

ENVIRONMENT=production
DIFY_BASE_URL=https://api.dify.ai/v1
# REQUIRED: API key of a PUBLISHED Dify app. Never use a placeholder or a leaked key.
DIFY_API_KEY=REPLACE_WITH_PUBLISHED_APP_KEY
DIFY_TIMEOUT_SECONDS=90
# Offline demo only: set DIFY_MOCK=1 to serve canned answers without Dify. Do NOT use in production.
DIFY_MOCK=0
# REQUIRED for production: jwt (never dev/none). Issue tokens with: python scripts/dev_token.py
AUTH_MODE=jwt
# REQUIRED: strong random secret >=32 chars, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
JWT_SECRET=REPLACE_WITH_32PLUS_RANDOM_HEX
JWT_ISSUER=dify-support-platform
RATE_LIMIT_PER_MINUTE=60
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=https://YOUR_DOMAIN
# Production uses Postgres, never sqlite. Password must match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql+psycopg://support:REPLACE_DB_PASSWORD@postgres:5432/support
# REQUIRED: Agent-facing Custom Tool credential. It cannot approve refunds.
TOOL_API_KEY=REPLACE_WITH_STRONG_TOOL_KEY
# REQUIRED: separate human-review credential for the reviewer-only Dify Tool provider.
REVIEWER_API_KEY=REPLACE_WITH_STRONG_REVIEWER_KEY
REVIEWER_ID=human-reviewer-01
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_STRONG_GRAFANA_PASSWORD